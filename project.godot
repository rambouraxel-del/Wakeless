; Engine configuration file.
; WAKELESS — jeu d'aventure narratif 3D (Godot 4.3+). Socle technique et graphique repris d'Éclat.

config_version=5

[application]

config/name="Wakeless"
config/description="Jeu d'aventure narratif 3D — prototype graphique (Bureau des rêves, forêt nocturne)."
run/main_scene="res://scenes/levels/bureau_des_reves.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

App="*res://scripts/app/app.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.06, 1)
